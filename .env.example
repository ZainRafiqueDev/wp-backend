PORT=4000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=

# Number of reverse proxies in front of the API. Production: 1 (one ALB /
# Caddy / Railway edge hop). 0 = ignore X-Forwarded-For (local dev only);
# must be a non-negative integer or the app refuses to start.
TRUST_PROXY_HOPS=0


DATABASE_URL=postgresql://postgres:postgres@localhost:5435/chatmate360

# WP-3.1 / CS-15: after applying db/schema.sql as postgres, switch API+worker
# to the non-bypass roles so policies bind (superuser ignores RLS). The roles
# are created WITHOUT a password; set your own (alter role ... with password)
# — production refuses to boot on a default or self-named password.
# DATABASE_URL=postgresql://chatmate360_app:<secret>@localhost:5435/chatmate360
# Admin/system scope work runs on this second login (required in production):
# SYSTEM_DATABASE_URL=postgresql://chatmate360_system:<other secret>@localhost:5435/chatmate360
RLS_ENABLED=true
RLS_APP_ROLE=chatmate360_app

# pg pool tuning — defaults sized for this app's actual current surface
# (admin/billing/commerce/document-ingestion/embeddings all share this pool
# with the chat path). Raise DB_POOL_MAX if requests are queuing waiting for
# a connection under real load, not before confirming that's the actual
# bottleneck (check pg_stat_activity / a slow-query log first).
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000

# Signs access + refresh tokens (see src/lib/auth.ts). Generate a real
# secret for anything beyond local dev, e.g.: openssl rand -hex 32
JWT_SECRET=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Optional — Google sign-in returns a clear "not configured" error until all
# three are set. Get these from a Google Cloud OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Demo chat must stay sandbox so it never touches real chatbot data.
DEMO_MODE=sandbox

# Chatbot answers (src/lib/ai.ts) — tried in order Claude -> Gemini -> OpenAI
# -> Ollama, skipping any whose key is blank. Leave all blank and chatbots
# fall back to the plain keyword matcher in src/lib/answerFromSources.ts.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Local fallback via `ollama serve` — no key/quota needed, just needs the
# model pulled (`ollama pull qwen2.5:7b-instruct-q4_K_M`).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Local Redis — see docker-compose.yml. Backs the async crawl job queue
# (src/lib/queue.ts, run with `npm run worker`) and public-widget chat rate
# limiting (src/middleware/rateLimitPublic.ts).
REDIS_URL=redis://localhost:6379
CRAWL_QUEUE_NAME=crawl-queue
CRAWL_WORKER_CONCURRENCY=3

# Public widget chat rate limits, per chatbot per requester IP. STRICT
# applies instead of the normal one when the Referer header doesn't
# corroborate the claimed embedding origin (see src/services/public.service.ts).
PUBLIC_CHAT_RATE_LIMIT_PER_MIN=20
PUBLIC_CHAT_RATE_LIMIT_STRICT_PER_MIN=5
# Shared across all AWS instances through Redis. Excess requests receive 503
# with Retry-After; slots expire after a crashed request/process.
PUBLIC_CHAT_MAX_CONCURRENT_PER_CHATBOT=10
PUBLIC_CHAT_CONCURRENCY_SLOT_TTL_SECONDS=45

# Cost control on the authenticated dashboard preview chat endpoint
# (POST /chatbots/chat), per user — see src/middleware/rateLimitAuthenticatedChat.ts.
AUTHENTICATED_CHAT_RATE_LIMIT_PER_MIN=30

# Chat-answer caching (src/lib/cache.ts, src/lib/answerChatbotQuestion.ts).
# All invalidated early (not just by TTL) whenever a chatbot's live data
# changes or a re-crawl completes — these are a secondary safety net, tune
# freely post-launch without a redeploy.
RELEVANCE_CACHE_TTL_SECONDS=900
ANSWER_CACHE_TTL_SECONDS=600
PAGES_CACHE_TTL_SECONDS=300
# Schema generation inside cacheKey(). Bump when prompt, retrieval, or
# grounding format changes so old Redis entries miss and expire.
CACHE_SCHEMA_VERSION=1

# Encrypts chatbot_integrations.api_key_encrypted at rest (src/lib/crypto.ts)
# — the credential Custom Actions AND the backend-link read tier
# (src/lib/backendLink.ts) both use to call a chatbot owner's own backend.
# Must be exactly 32 bytes, hex-encoded: openssl rand -hex 32
# Leave blank and PUT /chatbots/integration returns a clear 503 instead of
# storing a key insecurely.
INTEGRATION_ENCRYPTION_KEY=

# Backend link read tier (src/lib/backendLink.ts, see
# docs/BACKEND_INTEGRATION_CONTRACT.md) — how long a fetched
# products/availability response is cached per chatbot before the next chat
# message re-fetches it. Only bounds request volume to the owner's backend,
# not real-world staleness (see the doc comment on env.backendLinkCacheTtlSeconds).
BACKEND_LINK_CACHE_TTL_SECONDS=30

# Stripe Billing (src/lib/stripe.ts, src/services/billing.service.ts,
# POST /webhooks/stripe). Leave all blank and checkout/webhook routes return
# a clear 503 instead of constructing a Stripe client with no key.
# Use Test mode keys/prices while developing. Hosted Checkout only needs the
# secret key on the backend — no NEXT_PUBLIC Stripe key required for upgrades.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# How often the worker looks for stale unprocessed Stripe inbox rows.
STRIPE_INBOX_SWEEP_INTERVAL_MS=60000
# Replay only rows whose last attempt (or received_at) is older than this many seconds.
STRIPE_INBOX_REPLAY_DELAY=30
# /health warns when the oldest unprocessed inbox row is older than this.
STRIPE_INBOX_AGE_ALERT_SECONDS=300
# Delete processed inbox rows (including payload) after this many days. 0 keeps them.
STRIPE_INBOX_RETENTION_DAYS=90
# Stripe Price ids for each plan tier (Dashboard → Products → Price ID).
# Must be recurring subscription prices (not one-time).
STRIPE_PRICE_CRAWL_PLUS=
STRIPE_PRICE_FULL_CUSTOM=

# Pay-as-you-go credit top-ups — one-time (mode: "payment") Price ids.
STRIPE_PRICE_TOPUP_CLAUDE=
STRIPE_PRICE_TOPUP_OPENAI=
STRIPE_PRICE_TOPUP_GEMINI=
# Configured list prices. Grants are validated against these, not code literals.
TOPUP_SALE_USD=10
CRAWL_PLUS_SALE_USD=20
# Optional. When set, Full Custom monthly grant must stay below this sale.
FULL_CUSTOM_SALE_USD=

# AI dollars credited after a successful top-up. Must stay strictly below
# TOPUP_SALE_USD. If grant ≥ sale, billing grants disable and /health is degraded.
TOPUP_CREDIT_USD=4

# Resend for OTP, password-reset, invite and verification emails.
# Required in production: the API refuses to boot with NODE_ENV=production and
# no key, unless ALLOW_EMAIL_LOG_ONLY_IN_PRODUCTION=true (a deliberate
# email-less deployment; unsent emails are then logged as recipient hash +
# subject only, never the body). In local/dev, a blank key logs the email body
# with codes and links masked; set EMAIL_LOG_SHOW_SECRETS=true (ignored in
# production) to see them while testing locally.
RESEND_API_KEY=
ALLOW_EMAIL_LOG_ONLY_IN_PRODUCTION=false
EMAIL_LOG_SHOW_SECRETS=false
EMAIL_FROM=ChatMate360 <onboarding@resend.dev>

# Email OTP (dashboard verify + chatbot order-access). Express owns verification;
# the AI service must never mark a customer verified on its own.
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_SEND_RATE_LIMIT_PER_MIN=5
OTP_VERIFY_RATE_LIMIT_PER_MIN=10
OTP_PROOF_TTL_SECONDS=900
CUSTOMER_SESSION_TTL_SECONDS=2592000
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_FORGOT_RATE_LIMIT_PER_MIN=5

# Per-IP limit on POST /auth/login (customer sign-in). Matches the admin
# login default — this route had no rate limit at all until this was added.
LOGIN_RATE_LIMIT_PER_MIN=10

# CS-09: per-email (normalised, 15-minute window) and previously unlimited
# auth routes. All auth limiters fall back to a per-instance in-memory cap
# when Redis is down (never unlimited).
LOGIN_EMAIL_RATE_LIMIT_PER_15_MIN=10
ADMIN_LOGIN_EMAIL_RATE_LIMIT_PER_15_MIN=10
OTP_SEND_EMAIL_RATE_LIMIT_PER_15_MIN=5
OTP_VERIFY_EMAIL_RATE_LIMIT_PER_15_MIN=10
PASSWORD_FORGOT_EMAIL_RATE_LIMIT_PER_15_MIN=5
PASSWORD_RESET_RATE_LIMIT_PER_MIN=10
SIGNUP_RATE_LIMIT_PER_MIN=5
SIGNUP_EMAIL_RATE_LIMIT_PER_15_MIN=5
VERIFY_EMAIL_RATE_LIMIT_PER_MIN=10
RESEND_VERIFICATION_RATE_LIMIT_PER_MIN=5
RESEND_VERIFICATION_USER_RATE_LIMIT_PER_15_MIN=3

# Token-based metering (src/lib/aiPricing.ts, src/services/usage.service.ts)
# — a chatbot whose running estimated AI cost for the current calendar month
# reaches its plan's cap gets the graceful fallback message instead of a
# real AI call, checked against the plan actually read from Stripe
# (billing.service.ts), not a single global constant.
FREE_PLAN_MONTHLY_COST_CAP_USD=0.50
# Daily/weekly caps are burst/smoothing controls, not customer-facing
# credits. Enforcement is the same (any window can block answering), but
# visitors see "try again shortly" instead of "credits empty." Monthly USD
# is the only marketed credit allowance. All three windows refresh
# automatically via calendar day / ISO week / month keys. Daily/weekly are
# sized as a fraction of the monthly cap so a single bad day can't burn
# the whole month, while still leaving headroom for uneven usage.
FREE_PLAN_DAILY_COST_CAP_USD=0.05
FREE_PLAN_WEEKLY_COST_CAP_USD=0.15
# These values are the account-wide shared allowance across all chatbots and
# models. A matching per-chatbot/per-model ceiling remains as defense in depth.
# Crawl Plus monthly AI grant. Must stay strictly below CRAWL_PLUS_SALE_USD.
CRAWL_PLUS_PLAN_MONTHLY_COST_CAP_USD=8
CRAWL_PLUS_PLAN_DAILY_COST_CAP_USD=0.80
CRAWL_PLUS_PLAN_WEEKLY_COST_CAP_USD=2.40
FULL_CUSTOM_PLAN_MONTHLY_COST_CAP_USD=150
FULL_CUSTOM_PLAN_DAILY_COST_CAP_USD=15
FULL_CUSTOM_PLAN_WEEKLY_COST_CAP_USD=50

# Atomic reservations are estimated from prompt size and provider rates, then
# multiplied for safety. Estimates below the floor use the floor; estimates
# above the per-call maximum are rejected instead of being under-reserved.
# The old flat $0.05 reservation exhausted Free's daily cap after one reply.
MIN_PER_CALL_COST_RESERVATION_USD=0.0005
PER_CALL_COST_RESERVATION_USD=0.05
RESERVATION_ESTIMATE_MULTIPLIER=1.25

# Plan chatbot limits (src/lib/plans.ts), enforced by counting real rows at
# creation time, not a schema constraint. Full Custom is a high configurable
# ceiling, not literal unlimited.
FREE_PLAN_MAX_CHATBOTS=1
CRAWL_PLUS_PLAN_MAX_CHATBOTS=5
FULL_CUSTOM_PLAN_MAX_CHATBOTS=1000

# Quota-based model switching (Crawl Plus+, src/services/modelSelection.service.ts)
# — priority order a NEW conversation tries providers in (comma-separated,
# use "anthropic"/"openai"/"gemini" — matches lib/ai.ts's AiUsage.provider
# strings). Distinct from lib/ai.ts's own Claude->OpenAI->Gemini->Ollama
# chain, which is a *failure* fallback, not a quota decision.
MODEL_PRIORITY_ORDER=openai,anthropic,gemini
# Optional leftover — free plan uses the full chain above; prefer OpenAI first.
# FREE_PLAN_MODEL=openai
# Optional JSON override for the default $/1M-token rate table, e.g.
# {"gpt-4o-mini":{"inputPerMillion":0.15,"outputPerMillion":0.6}} — use this
# to correct pricing without a redeploy when a provider changes rates.
AI_PRICING_OVERRIDES_JSON=

# pgvector cosine distance: smaller is more similar. Chunks farther than this
# are omitted rather than injecting unrelated document text into the prompt.
DOCUMENT_RETRIEVAL_MAX_DISTANCE=0.65
DOCUMENT_RETRIEVAL_LIMIT=5
# HNSW candidates per lookup (SET LOCAL hnsw.ef_search). Raise if filtered recall drops.
PGVECTOR_HNSW_EF_SEARCH=40

# WP-2.3 hybrid retrieval. RETRIEVAL_MODE=vector rolls back to HNSW only.
# `simple` keeps SKU/id tokens. Shadow-compare logs hybrid vs vector overlap.
RETRIEVAL_MODE=hybrid
RETRIEVAL_TS_CONFIG=simple
RETRIEVAL_RRF_K=60
RETRIEVAL_LEXICAL_CANDIDATES=20
RETRIEVAL_VECTOR_CANDIDATES=20
RETRIEVAL_SHADOW_COMPARE=false

# WP-3.2 rerank. Widens the fused candidate pool to RETRIEVAL_RERANK_CANDIDATE_POOL
# and has a cheap LLM (same fallback chain as query rewriting) reorder it by
# actual relevance before truncating to DOCUMENT_RETRIEVAL_LIMIT. Set to false
# to roll back to plain RRF-fused order (no LLM call, no added latency/cost).
RETRIEVAL_RERANK_ENABLED=true
RETRIEVAL_RERANK_CANDIDATE_POOL=15

# WP-2.4 embedding model/dim + daily tenant budget. Daily default is
# CRAWL_PLUS_PLAN_MONTHLY_COST_CAP_USD / 30 ($8 economics). Rollback:
# EMBEDDING_BUDGET_ENABLED=false. Same-dim model changes coexist; set
# EMBEDDING_REEMBED_ON_SWEEP=true for gradual cutover. Other dims fail closed.
# EMBEDDING_MODEL=text-embedding-3-small
# PRODUCT_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BUDGET_ENABLED=true
# EMBEDDING_DAILY_BUDGET_USD=0.2667
# EMBEDDING_PRICING_OVERRIDES_JSON={"text-embedding-3-small":0.02}
EMBEDDING_REEMBED_ON_SWEEP=false

# WP-2.5 RAG eval gate. Skip only with an explicit override.
# RAG_EVAL_SKIP=false
# RAG_EVAL_MIN_RECALL_AT_5=0.8
# RAG_EVAL_MIN_RECALL_AT_10=0.85
# RAG_EVAL_MIN_MRR=0.7
# RAG_EVAL_MAX_HALLUCINATION_RATE=0.05
# RAG_EVAL_ARTIFACT_PATH=evals/rag/artifacts/last-run.json

# WP-3.5 regression gate. The thresholds above are absolute floors; these
# compare each run against the last accepted one (evals/rag/baseline.json), so
# quality can't erode gradually while still clearing the floor. Re-baseline
# with `npm run eval:rag -- --update-baseline` after an intentional change.
# RAG_EVAL_BASELINE_PATH=evals/rag/baseline.json
# RAG_EVAL_MAX_REGRESSION=0.03
# RAG_EVAL_UPDATE_BASELINE=false

# WP-1.5 document ingest caps (Full Custom defaults — mislabeled "Crawl
# Plus defaults" until this pass; Crawl Plus has its own separate
# CRAWL_PLUS_DOC_MAX_* vars below). Per-chatbot columns max_documents /
# max_bytes / max_chunks override documents, total bytes, and total
# chunks. There is no page column — page-like bounds are chunks.
DOCUMENT_MAX_PER_CHATBOT=25
DOCUMENT_MAX_FILE_BYTES=20971520
DOCUMENT_MAX_CHATBOT_BYTES=524288000
DOCUMENT_MAX_CHUNKS_PER_DOCUMENT=400
DOCUMENT_MAX_CHUNKS_PER_CHATBOT=10000

# WP-2.1 async document ingest. HTTP persists bytes then returns 202.
# Set DOCUMENT_INGEST_ASYNC=false to process files <= SYNC_MAX_BYTES inline
# (rollback). Driver `fs` is local/CI; `s3` is MinIO/AWS. Keep the bucket
# on rollback. Worker concurrency is 1–2.
DOCUMENT_INGEST_ASYNC=true
DOCUMENT_INGEST_SYNC_MAX_BYTES=15728640
DOCUMENT_INGEST_QUEUE_NAME=document-ingest
DOCUMENT_INGEST_WORKER_CONCURRENCY=2
DOCUMENT_INGEST_STALE_PROCESSING_MS=1800000
DOCUMENT_STORAGE_DRIVER=fs
DOCUMENT_STORAGE_DIR=var/document-storage
DOCUMENT_STORAGE_BUCKET=
DOCUMENT_STORAGE_REGION=us-east-1
DOCUMENT_STORAGE_ENDPOINT=
DOCUMENT_STORAGE_ACCESS_KEY=
DOCUMENT_STORAGE_SECRET_KEY=

# WP-2.2 malware scan (worker, before parse; also used by Phase 3 chat
# attachments). Production is always fail-closed and ignores
# DOCUMENT_SCAN_SKIP. Set vendor=clamav and run `docker compose up -d
# clamav` (docker-compose.yml) for a real local scanner — HOST/PORT below
# already match that service's published port — or pause uploads if the
# scanner is down.
DOCUMENT_SCAN_VENDOR=mock
DOCUMENT_SCAN_CLAMD_HOST=127.0.0.1
DOCUMENT_SCAN_CLAMD_PORT=3310
DOCUMENT_SCAN_TIMEOUT_MS=10000
DOCUMENT_SCAN_FAIL_CLOSED=true
DOCUMENT_SCAN_SKIP=false
DOCUMENT_SCAN_PAUSE_UPLOADS=false

# assertProductionGuards() (src/env.ts, called at boot by both src/index.ts
# and src/worker.ts) refuses to start when NODE_ENV=production and either
# DOCUMENT_STORAGE_DRIVER is left at "fs" (local disk, lost on
# restart/redeploy) or DOCUMENT_SCAN_VENDOR is left at "mock" (doesn't
# actually scan for malware) — unless this is explicitly set to true.
# Leave this false; only set it true for a deliberate "production" that
# really does want local-disk storage (e.g. an ephemeral demo environment).
ALLOW_UNSAFE_PROD_DEFAULTS=false
# The mock scanner has its own opt-out, NOT covered by the flag above. Never
# set this true anywhere real customers upload files.
ALLOW_MOCK_MALWARE_SCAN_IN_PRODUCTION=false

# Admin dashboard (src/lib/auth.ts, src/services/admin.service.ts,
# src/middleware/rateLimitAdminLogin.ts) — see docs/ADMIN_SETUP.md for how
# to create the first admin_users row (npm run create-admin).
ADMIN_ACCESS_TOKEN_TTL_SECONDS=28800
ADMIN_LOGIN_RATE_LIMIT_PER_MIN=10
# WP-2.6 admin Full Custom activation. Safe monthly credits = attested cash
# × this ratio (same ledger as Crawl Plus). Must be in (0, 1). Exceeding
# the safe amount requires overrideReason of at least MIN_LENGTH characters.
ADMIN_PLAN_AI_BUDGET_RATIO=0.4
ADMIN_PLAN_PERIOD_DAYS=30
ADMIN_PLAN_OVERRIDE_REASON_MIN_LENGTH=12

# Free trial (src/services/accessGate.service.ts) — days from
# users.trial_started_at before an unpaid account's chatbot(s) stop
# answering on the public widget (data is never deleted, just gated).
TRIAL_LENGTH_DAYS=30

# Abuse detection (src/services/abuseDetection.service.ts) — flags a
# chatbot after this many answer-cache-MISSING questions within this many
# seconds. Auto-deactivation is opt-in (default off) — see the doc comment
# on env.abuseAutoDeactivate for why flagging always happens but disabling
# a real customer's chatbot on a heuristic doesn't, by default.
ABUSE_WINDOW_SECONDS=60
ABUSE_REQUEST_THRESHOLD=20
ABUSE_AUTO_DEACTIVATE=false

# Incremental re-crawl cron (src/services/recrawl.service.ts, src/worker.ts)
# — how often each active chatbot's website is re-checked for changed pages.
RECRAWL_INTERVAL_MS=604800000

# Conversation memory (src/services/conversation.service.ts) — how many
# recent turns are sent as context on every message, and the turn count at
# which older turns get folded into a compact summary instead.
CONVERSATION_CONTEXT_TURNS=6
CONVERSATION_SUMMARY_THRESHOLD_TURNS=20

# WP-3.4 advanced session memory. Conversations idle for TTL days are deleted;
# the TTL is refreshed on every turn. Compaction runs on the worker rather than
# in the reply path, so a long conversation never slows down an answer.
CONVERSATION_TTL_DAYS=30
# CONVERSATION_MAINTENANCE_INTERVAL_MS=60000
# CONVERSATION_COMPACT_BATCH_SIZE=25
# Cross-session memory (summaries + extracted facts) is purged this many days
# after its last update. Set to 0 to keep it indefinitely.
SESSION_MEMORY_RETENTION_DAYS=180
# Structured fact extraction. Off falls back to summary-only memory.
SESSION_MEMORY_FACTS_ENABLED=true
# Facts kept per customer per chatbot; oldest-seen are evicted past this.
SESSION_MEMORY_MAX_FACTS=25

# Full Custom: WooCommerce-connected commerce pipeline (src/langgraph/,
# src/lib/woocommerce/). A separate BullMQ queue from the crawl queue —
# webhook processing/payment reconciliation are operationally distinct work.
COMMERCE_QUEUE_NAME=commerce-queue
COMMERCE_WORKER_CONCURRENCY=3
# PaymentReconciliationJob (the safety net for missed/delayed/failed
# webhooks) — how often it ticks, and how old a PENDING_PAYMENT order must
# be before it's checked (gives a normal fast checkout time to resolve on
# its own via the webhook first).
PAYMENT_RECONCILIATION_INTERVAL_MS=600000
PAYMENT_RECONCILIATION_THRESHOLD_MS=300000
# Product-catalog embedding model (src/services/embeddings.service.ts) —
# reuses OPENAI_API_KEY above; product search falls back to a plain SQL
# match when that key isn't set, never a hard failure.
PRODUCT_EMBEDDING_MODEL=text-embedding-3-small

# Error tracking (src/lib/sentry.ts). Blank means errors are only visible in
# stdout logs — a real gap in production. A boot warning fires if this is
# unset; it never blocks startup. Request bodies, query strings, auth
# headers, and PII are stripped before any event leaves the process.
SENTRY_DSN=
