# Not loaded automatically — vitest.config.ts's `test.env` sets sensible test
# defaults directly (pointing at a local `chatmate360_test` database and the
# same local Redis dev already uses). The two database URLs below must be
# exported in your shell (no password is baked into vitest.config.ts).
# This file exists for two things:
#
# 1. Documenting what the test suite actually needs, in one place.
# 2. Letting CI or a contributor override a default via TEST_DATABASE_URL /
#    TEST_REDIS_URL env vars (read by vitest.config.ts) if their local/CI
#    Postgres or Redis isn't on the default ports below.

# A separate database from local dev's `chatmate360` — tests create and drop
# real rows, and running them against your dev data would be destructive.
# Create it once, then apply db/schema.sql to it, same as the dev DB:
#   docker exec -i <postgres-container> psql -U postgres -c "create database chatmate360_test"
#   docker exec -i <postgres-container> psql -U postgres -d chatmate360_test < db/schema.sql
# CS-15: the roles are created without a password. Set one locally, once:
#   docker exec -i <postgres-container> psql -U postgres -c "alter role chatmate360_app with password '<local secret>'"
#   docker exec -i <postgres-container> psql -U postgres -c "alter role chatmate360_system with password '<other local secret>'"
TEST_DATABASE_URL=postgresql://chatmate360_app:<local secret>@127.0.0.1:5435/chatmate360_test
TEST_SYSTEM_DATABASE_URL=postgresql://chatmate360_system:<other local secret>@127.0.0.1:5435/chatmate360_test
# The suite expects the CS-15 lockdown, which db/schema.sql does not apply:
#   docker exec -i <postgres-container> psql -U postgres -d chatmate360_test < db/migrations/20261115_rls_2_lockdown.sql

# Reuses the same local Redis dev already runs (docker-compose.yml) — safe to
# share because vitest.config.ts sets CRAWL_QUEUE_NAME to "crawl-queue-test"
# (distinct from dev's "crawl-queue") and DOCUMENT_INGEST_QUEUE_NAME to
# "document-ingest-test", so a real dev worker never picks up a job a test
# run enqueues, and rate-limit keys are namespaced per-test by a freshly
# created chatbot id, so there's no cross-run collision either.
TEST_REDIS_URL=redis://localhost:6379
