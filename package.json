{
  "name": "chatmate360-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "worker": "tsx watch src/worker.ts",
    "worker:start": "tsx src/worker.ts",
    "create-admin": "tsx scripts/createAdmin.ts",
    "seed-super-admin": "tsx scripts/seedSuperAdmin.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:eval": "vitest run tests/eval tests/unit/ragEvalMetrics.test.ts",
    "eval:rag": "tsx scripts/runRagEval.ts",
    "test:coverage": "vitest run --coverage",
    "security:check": "node scripts/security/check-autorun.mjs && node scripts/security/check-autorun.selftest.mjs && node scripts/security/check-malware-patterns.mjs && node scripts/security/check-supply-chain.mjs && node scripts/security/check-supply-chain-and-malware.selftest.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1176.0",
    "@langchain/core": "^1.5.1",
    "@langchain/langgraph": "^1.7.5",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.4",
    "@langchain/openai": "^1.8.5",
    "@sentry/node": "^11.17.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.0",
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "pdf-parse": "^1.1.4",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "playwright": "^1.65.1",
    "rate-limiter-flexible": "^5.0.5",
    "stripe": "^22.6.1",
    "tsx": "^4.23.15",
    "undici": "7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.3.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^10.15.0",
    "supertest": "^7.3.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.74.0",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
